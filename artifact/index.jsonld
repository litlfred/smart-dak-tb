    {
      "@id": "Requirements-TB.FXNREQ.001.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.001.A",
      "dcterms:title": " Search for the client record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Search for the client record:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>To search to see whether client is already in the system (using at least two identifiers)\n\nso that\n\n>I can check whether this is a new or existing client",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.001.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.001.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.002.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.002.A",
      "dcterms:title": " Search for the client record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Search for the client record:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>The system to be able to work offline \n\nso that\n\n>I can carry on the TB care service provision regardless of an Internet connection. Once the system goes back online, the data are synchronized with the central system",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.002.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.002.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.003.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.003.A",
      "dcterms:title": " Search for the client record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Search for the client record:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>The system to display sufficient data to identify the client\n\nso that\n\n>I can confirm that it is the correct client",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.003.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.003.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.004.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.004.A",
      "dcterms:title": " Search for the client record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Search for the client record:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>The system to require me (a user) to search to see whether a client is already in the system before starting a new medical record entry\n\nso that\n\n>I can avoid duplicates and update information as necessary",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.004.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.004.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.005.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.005.A",
      "dcterms:title": " Search for the client record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Search for the client record:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>To use the client identification system (e.g. quick response [QR] code, barcode, fingerprint) and pull up client information\n\nso that\n\n>I can confirm that it is the correct client and update the information as necessary",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.005.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.005.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.006.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.006.A",
      "dcterms:title": " Search for the client record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Search for the client record:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>To provide sufficient data to rule out the possibility that this client is already in the system\n\nso that\n\n>I can avoid duplicates ",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.006.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.006.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.007.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.007.A",
      "dcterms:title": " Create a new client record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Create a new client record:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>To be able to enter identification information\n\nso that\n\n>I can enter new client information",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.007.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.007.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.008.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.008.A",
      "dcterms:title": " Create a new client record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Create a new client record:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>The system to indicate mandatory fields that must be filled out for the registration to be valid\n\nso that\n\n>I can ensure all necessary information has been completed",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.008.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.008.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.009.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.009.A",
      "dcterms:title": " Create a new client record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Create a new client record:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>To generate a facility medical record number \n\nso that\n\n>I can check and confirm the information",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.009.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.009.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.010.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.010.A",
      "dcterms:title": " Create a new client record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Create a new client record:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>To edit fields on screen before information is committed\n\nso that\n\n>I can ensure information has been checked before submission",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.010.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.010.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.011.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.011.A",
      "dcterms:title": " Create a new client record",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Create a new client record:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>To enter a temporary identification in situations when full identity is unknown\n\nso that\n\n>I can proceed with registration and update the information later on, once identity information is provided",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.011.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.011.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.012.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.012.A",
      "dcterms:title": " Validate the client details",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Validate the client details:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>To display client information for validation (and be able to edit it)\n\nso that\n\n>I can ensure information has been checked before submission",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.012.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.012.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.013.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.013.A",
      "dcterms:title": " Validate the client details",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Validate the client details:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>To be able to update demographic information\n\nso that\n\n>The most current information about the client can be recorded",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.013.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.013.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.014.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.014.A",
      "dcterms:title": " Validate the client details",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Validate the client details:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>The system to retain previous history of updated information\n\nso that\n\n>I can review past information",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.014.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.014.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.015.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.015.A",
      "dcterms:title": " Validate the client details",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Validate the client details:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>To be able to attach an identifier (e.g. QR code, barcode, fingerprint, photo) to the client's record based on national standard-based consent\n\nso that\n\n>I have additional ways of identifying client",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.015.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.015.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.016.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.016.A",
      "dcterms:title": " Validate the client details",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Validate the client details:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>To be able to confirm the client's identity\n\nso that\n\n>I can be sure it is the right person",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.016.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.016.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.017.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.017.A",
      "dcterms:title": " Validate the client details",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Validate the client details:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>If this is a returning contact, to add the information to their previous contact\n\nso that\n\n>I can link the information across different contacts",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.017.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.017.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.018.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.018.A",
      "dcterms:title": " Check in the client",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Check in the client:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>The system to record a time-and-date-stamped new contact (encounter)\n\nso that\n\n>I can confirm when the client came",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.018.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.018.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.019.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.019.A",
      "dcterms:title": " Check in the client",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Check in the client:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>Provide a list of scheduled contacts to allow clients that are on TB preventive treatment or TB treatment who are lost to follow-up to be traced\n\nso that\n\n>I can track and follow up clients requiring TB care services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.019.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.019.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.020.A.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.020.A",
      "dcterms:title": " Check in the client",
      "dcterms:description": "*Business process* (A) Registration:\nActivity:  Check in the client:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerkormedicalofficereceptionist.html\">Health worker or data entry clerk or medical office receptionist</a>, I want to:\n>Provide a list or roster of all clients due to arrive\n\nso that\n\n>I know which clients to follow up or are due for services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.020.A"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.020.A.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.021.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.021.B",
      "dcterms:title": " Provide pre-screening information and ask for consent",
      "dcterms:description": "*Business process* (B) Screening:\nActivity:  Provide pre-screening information and ask for consent:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To have available general pre-screening information about potential risks and benefits, screening tools and procedure to share with clients during counselling activities\n\nso that\n\n>I can better answer the client’s questions and better prepare them for screening activities",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.021.B"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.021.B.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.022.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.022.B",
      "dcterms:title": " Provide pre-screening information and ask for consent",
      "dcterms:description": "*Business process* (B) Screening:\nActivity:  Provide pre-screening information and ask for consent:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>The system to prompt the health worker to get informed consent from the client before proceeding with screening\n\nso that\n\n>I can ensure that ethical principles for screening for infectious diseases are followed and that the clients’ rights are protected",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.022.B"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.022.B.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.023.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.023.B",
      "dcterms:title": " Assess medical history and risk factors",
      "dcterms:description": "*Business process* (B) Screening:\nActivity:  Assess medical history and risk factors:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able to capture or update client information related to medical history and risk factors for TB\n\nso that\n\n>I make sure that new relevant information is not missed",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.023.B"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.023.B.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.024.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.024.B",
      "dcterms:title": " Determine the screening algorithm",
      "dcterms:description": "*Business process* (B) Screening:\nActivity:  Determine the screening algorithm:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To have available general information about screening algorithms \n\nso that\n\n>I have a quick reference to help me choose the most appropriate screening algorithm for a client or group of clients",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.024.B"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.024.B.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.025.B.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.025.B",
      "dcterms:title": " Perform the TB screening",
      "dcterms:description": "*Business process* (B) Screening:\nActivity:  Perform the TB screening:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able to send referral letters via appropriate digital tools (e.g. email, digital health portal)\n\nso that\n\n>I can speed up the referral process and check-in at the accommodating health-care facility",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.025.B"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.025.B.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.026.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.026.C",
      "dcterms:title": " Carry out clinical examination",
      "dcterms:description": "*Business process* (C) Diagnosis:\nActivity:  Carry out clinical examination:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>The system to use the data entered for a client to generate statistics, graphs, pop-ups (on demand or ad hoc)\n\nso that\n\n>I can take better clinical decisions",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.026.C"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.026.C.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.027.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.027.C",
      "dcterms:title": " Assess medical history and risk factors",
      "dcterms:description": "*Business process* (C) Diagnosis:\nActivity:  Assess medical history and risk factors:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able to route the consultation via different health workers and save in the system the information already entered to the consultation even if the consultation is not yet complete, enabling other health workers to see the information already entered and to be able to add or edit information as it becomes available\n\nso that\n\n>I do not have to start a new consultation for every health worker that the client is involved with",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.027.C"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.027.C.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.028.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.028.C",
      "dcterms:title": "C4 Assess history of prior TB treatment",
      "dcterms:description": "*Business process* (C) Diagnosis:\nActivity: C4 Assess history of prior TB treatment:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able to check client's medical history \n\nso that\n\n>I can use this information for investigations or treatment recommendations",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.028.C"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.028.C.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.029.C.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.029.C",
      "dcterms:title": " Interpret the follow-on test(s) results",
      "dcterms:description": "*Business process* (C) Diagnosis:\nActivity:  Interpret the follow-on test(s) results:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>The system to be capable to receive diagnosis test results from laboratories or other test centres \n\nso that\n\n>I can take the appropriate actions more quickly",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.029.C"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.029.C.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.030.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.030.D",
      "dcterms:title": " Determine the regimen designed to treat rifampicin-resistant TB",
      "dcterms:description": "*Business process* (D) TB Treatment:\nActivity:  Determine the regimen designed to treat rifampicin-resistant TB:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>The system to propose TB treatment regimens based on predefined criteria and on the information available in the system\n\nso that\n\n>It helps me selecting the appropriate treatment regimen for the client",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.030.D"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.030.D.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.031.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.031.D",
      "dcterms:title": " Determine the regimen designed to treat rifampicin-resistant TB",
      "dcterms:description": "*Business process* (D) TB Treatment:\nActivity:  Determine the regimen designed to treat rifampicin-resistant TB:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be alerted if a client is allergic to TB-related medications (specify the drugs)\n\nso that\n\n>I immediately know that I cannot prescribe these drugs and client safety is better protected",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.031.D"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.031.D.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.032.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.032.D",
      "dcterms:title": " Initiate the treatment and discuss adherence",
      "dcterms:description": "*Business process* (D) TB Treatment:\nActivity:  Initiate the treatment and discuss adherence:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>The system to automatically calculate the expected TB treatment completion date\n\nso that\n\n>I do not have to calculate this myself",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.032.D"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.032.D.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.033.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.033.D",
      "dcterms:title": " Develop monitoring examinations and a schedule of follow-up visits",
      "dcterms:description": "*Business process* (D) TB Treatment:\nActivity:  Develop monitoring examinations and a schedule of follow-up visits:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To have the system automatically calculate a date when the client should return for care, based on treatment regimen, clinical condition and monitoring examinations\n\nso that\n\n>I do not have to calculate this myself",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.033.D"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.033.D.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.034.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.034.D",
      "dcterms:title": " Perform the clinical assessment",
      "dcterms:description": "*Business process* (D) TB Treatment:\nActivity:  Perform the clinical assessment:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>The system to trigger an alert when a client did not show-up on the intended follow-up day, according to the follow-up schedule\n\nso that\n\n>I could follow up the client in a timely manner to prevent them from being lost to follow-up",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.034.D"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.034.D.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.035.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.035.D",
      "dcterms:title": " Manage TB treatment interruptions",
      "dcterms:description": "*Business process* (D) TB Treatment:\nActivity:  Manage TB treatment interruptions:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>The system to be able to exchange information with digital adherence technologies to automatically record and calculate information related to treatment progress or interruptions\n\nso that\n\n>I do not have to calculate this myself and fill in the information manually",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.035.D"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.035.D.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.036.D.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.036.D",
      "dcterms:title": " Report the outcome(s)",
      "dcterms:description": "*Business process* (D) TB Treatment:\nActivity:  Report the outcome(s):\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>The system to trigger an alert to assign treatment outcome in case the expected TB treatment completion date is reached and there is no treatment outcome assigned\n\nso that\n\n>Alignment between the number of cases notified and number of treatment outcome cohort (all notified cases have assigned treatment outcomes) is ensured",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.036.D"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.036.D.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.037.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.037.E",
      "dcterms:title": " Offer TB prevention counselling",
      "dcterms:description": "*Business process* (E) TB preventive treatment (TPT):\nActivity:  Offer TB prevention counselling:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be prompted to provide counselling on TPT\n\nso that\n\n>I can ensure that the client is educated on TPT before offering any TPT-related service",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.037.E"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.037.E.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.038.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.038.E",
      "dcterms:title": " Make an informed decision",
      "dcterms:description": "*Business process* (E) TB preventive treatment (TPT):\nActivity:  Make an informed decision:\nAs a <a href=\"ActorDefinition-healthinformationofficer.html\">Health information officer</a>, I want to:\n>The system to prompt the health worker to get informed consent from the client before proceeding with the TPT evaluation\n\nso that\n\n>I can ensure that client rights are protected",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.038.E"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.038.E.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.039.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.039.E",
      "dcterms:title": " Determine whether TB infection testing is relevant",
      "dcterms:description": "*Business process* (E) TB preventive treatment (TPT):\nActivity:  Determine whether TB infection testing is relevant:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To have available general information about TB infection testing\n\nso that\n\n>I will not have to look elsewhere to find information",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.039.E"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.039.E.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.040.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.040.E",
      "dcterms:title": " Determine TPT eligibility",
      "dcterms:description": "*Business process* (E) TB preventive treatment (TPT):\nActivity:  Determine TPT eligibility:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To have questions that guide me in TPT eligibility assessment\n\nso that\n\n>I can better evaluate client TPT eligibility",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.040.E"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.040.E.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.041.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.041.E",
      "dcterms:title": " Determine TPT eligibility",
      "dcterms:description": "*Business process* (E) TB preventive treatment (TPT):\nActivity:  Determine TPT eligibility:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able to use my clinical judgement when deciding if a client is eligible or not for TPT and enter the decision in the system\n\nso that\n\n>I do not prevent clients from taking TPT when they are eligible with clinical judgement (e.g. when the benefits of TPT outweighs the risks)",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.041.E"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.041.E.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.042.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.042.E",
      "dcterms:title": " Initiate TPT and develop an adherence plan",
      "dcterms:description": "*Business process* (E) TB preventive treatment (TPT):\nActivity:  Initiate TPT and develop an adherence plan:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To have available general information about TPT adherence\n\nso that\n\n>I can better prepare the TPT adherence plan",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.042.E"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.042.E.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.043.E.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.043.E",
      "dcterms:title": " Schedule the follow-up visit",
      "dcterms:description": "*Business process* (E) TB preventive treatment (TPT):\nActivity:  Schedule the follow-up visit:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able to indicate if the client agrees to receive notifications and their preferred communication channel (including sending reminders for the next follow-up visit)\n\nso that\n\n>I can send communications via the client's preferred communication channel",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.043.E"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.043.E.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.044.F.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.044.F",
      "dcterms:title": " Stabilize the client and give pre-referral treatment",
      "dcterms:description": "*Business process* (F) Referral:\nActivity:  Stabilize the client and give pre-referral treatment:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able to bypass the standard flow at any point if danger signs are present or emergency care is needed; urgent cases should be flagged and seen promptly\n\nso that\n\n>The client can be referred, if needed",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.044.F"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.044.F.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.045.F.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.045.F",
      "dcterms:title": " Identify and discuss referral location options",
      "dcterms:description": "*Business process* (F) Referral:\nActivity:  Identify and discuss referral location options:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able to find out in the system where the required service may be available \n\nso that\n\n>I can refer my client to another facility to receive the appropriate services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.045.F"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.045.F.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.046.F.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.046.F",
      "dcterms:title": " Contact referral facility",
      "dcterms:description": "*Business process* (F) Referral:\nActivity:  Contact referral facility:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able to send a referral request to a health centre\n\nso that\n\n>I can refer my client for them to receive the appropriate services",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.046.F"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.046.F.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.047.F.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.047.F",
      "dcterms:title": " Contact referral facility",
      "dcterms:description": "*Business process* (F) Referral:\nActivity:  Contact referral facility:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To have a list of the contact information for referral facilities\n\nso that\n\n>I can easily contact the facility when making the referral arrangements",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.047.F"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.047.F.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.048.F.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.048.F",
      "dcterms:title": " Provide information to the receiving facility",
      "dcterms:description": "*Business process* (F) Referral:\nActivity:  Provide information to the receiving facility:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To indicate in the system the referral reason\n\nso that\n\n>I can identify ways to improve the TB care process at my health-care facility",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.048.F"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.048.F.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.049.F.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.049.F",
      "dcterms:title": " Provide information to the receiving facility",
      "dcterms:description": "*Business process* (F) Referral:\nActivity:  Provide information to the receiving facility:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To share the client’s health records with the referral facility \n\nso that\n\n>They can provide the care my client needs",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.049.F"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.049.F.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.050.F.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.050.F",
      "dcterms:title": "  Check whether the client can be accommodated",
      "dcterms:description": "*Business process* (F) Referral:\nActivity:   Check whether the client can be accommodated:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able the check if the supplies and skills needed to accommodate a referred client are available at my facility\n\nso that\n\n>I can validate to the referring facility (or directly to the client) where the client can be accommodated",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.050.F"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.050.F.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.051.F.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.051.F",
      "dcterms:title": " Receive the client",
      "dcterms:description": "*Business process* (F) Referral:\nActivity:  Receive the client:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To know what care the client received at the referral facility \n\nso that\n\n>I can provide appropriate care if my client comes back to my facility",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.051.F"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.051.F.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.052.G.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.052.G",
      "dcterms:title": " Generate aggregate reports",
      "dcterms:description": "*Business process* (G) Aggregate reporting and data use:\nActivity:  Generate aggregate reports:\nAs a <a href=\"ActorDefinition-healthworkerordataentryclerk.html\">Health worker or data entry clerk</a>, I want to:\n>To produce a range of prepared reports\n\nso that\n\n>I do not need to create the reports manually for reporting purposes",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.052.G"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.052.G.json"
      }
    },
    {
      "@id": "Requirements-TB.FXNREQ.053.G.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/TB.FXNREQ.053.G",
      "dcterms:title": " Analyse and interpret the reports",
      "dcterms:description": "*Business process* (G) Aggregate reporting and data use:\nActivity:  Analyse and interpret the reports:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To view a range of standardized visualizations (e.g. charts, tables, maps)\n\nso that\n\n>I am able to use data collected at the facility for service delivery and informing programmatic actions with the aim of improving the quality of care for clients with TB",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.053.G"
      },
      "schema:contentUrl": {
        "@id": "../Requirements-TB.FXNREQ.053.G.json"
      }
    },
